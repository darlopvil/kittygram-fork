<% local proxy_url = require("lib.helpers").proxy_url %>
<% local json = require("cjson") %>

<main id="main">
    <h2 class="item-heading"><%= strings.explore.posts_matching .. explore_query %></h2>
    <div class="tile-container">
        <% for _, item in ipairs(results.items) do %>
            <div class="tile-item">
                <div class="user-info">
                    <img src="<%= proxy_url(item.user.profile_picture) %>" loading="lazy">
                    <a class="username" href="<%= "/" .. item.user.username %>"> <%= item.user.username %> </a>
                </div>
                <div class="tile-item-media">
                    <% if item.video_url then %>
                        <video controls preload="none" poster="<%= proxy_url(item.thumbnail) %>">
                            <% if session.disable_video_proxying then %>
                                <source crossorigin="anonymous" src="<%= item.video_url %>">
                            <% else %>
                                <source src="<%= proxy_url(item.video_url) %>">
                            <% end %>
                        </video>
                    <% end %>
                </div>
            </div>
        <% end %>
    </div>
    <% if results.end_cursor then %>
        <a href="<%= "/popular/" .. explore_query .. "/?after=" .. results.end_cursor %>" class="next-button"><%= strings.next_page %></a>
    <% end %>
</main>

