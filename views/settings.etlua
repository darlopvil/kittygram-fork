<main id="main">
    <h2 class="item-heading"><%= strings.settings.settings %></h2>
    <div class="item-card">
        <form class="settings-form" method="POST" action="/settings/save">
            <span>
                <label for="language"><%= strings.settings.language %></label>
                <select name="language">
                    <% for _, language in pairs(languages) do %>
                        <% if language.id == selected_language then%>
                            <option value="<%= language.id %>" selected><%= language.name %></option>
                        <% else %>
                            <option value="<%= language.id %>"><%= language.name %></option>
                        <% end %>
                    <% end %>
                </select>
            </span>
            <span>
                <label for="theme"><%= strings.settings.theme %></label>
                <select name="theme">
                    <% for _, theme in pairs(themes) do %>
                        <% if theme.name == selected_theme then %>
                            <option value="<%= theme.name %>" selected><%= theme.display_name %></option>
                        <% else %>
                            <option value="<%= theme.name %>"><%= theme.display_name %></option>
                        <% end %>
                    <% end %>
                </select>
            </span>
            <span>
                <label for="sticky_navbar"><%= strings.settings.keep_nav_fixed %></label>
                <% if sticky_navbar then %>
                    <input type="checkbox" name="sticky_navbar" checked>
                <% else %>
                    <input type="checkbox" name="sticky_navbar">
                <% end %>
            </span>
            <span>
                <label for="disable_video_proxying"><%= strings.settings.disable_video_proxying %></label>
                <% if disable_video_proxying then %>
                    <input type="checkbox" name="disable_video_proxying" checked>
                <% else %>
                    <input type="checkbox" name="disable_video_proxying">
                <% end %>
            </span>
            <button><%= strings.settings.save_settings %></button>
        </form><form class="reset-form" method="POST" action="/settings/reset">
            <button><%= strings.settings.reset_settings %></button>
        </form>
    </div>
</main>
