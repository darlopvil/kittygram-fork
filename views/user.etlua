<% local proxy_url = require("lib.helpers").proxy_url %>
<% local json = require("cjson") %>

<main id="main">
    <div class="item-card user-info">
        <div class="profile-picture">
            <img src="<%= proxy_url(user.profile_pic_url) %>" loading="lazy">
        </div>
        <div class="usernames" >
            <p> <%= user.full_name %> </p>
            <p> <%= user.username %> </p>
        </div>
        <div class="user-bio">
            <p class="user-bio-text"><%= user.biography %></p>
        </div>
    </div>

    <% if user.is_private then %>
        <div class="item-card">
            <h3>This user is private.</h3>
            <a href="<%= view_on_instagram_link %>">View on instagram</a>
        </div
    <% elseif #posts < 1 then %>
        <div class="item-card">
            <h3>This user has no posts.</h3>
        </div>
    <% else %>
        <div class="user-posts">
            <h2 class="item-heading"> Posts </h2>
            <% for _, post in ipairs(posts) do %>
                <% post = post.node %>
            
                <div class="item-card post">
                    <div class="user-info">
                        <img src="<%= proxy_url(post.user.profile_pic_url) %>" loading="lazy">
                        <a class="username" href="<%= "/" .. post.user.username %>"> <%= post.user.username %> </a>
                    </div>
                    <div class="post-image">
                        <% if type(post.video_versions) == "table" then %>
                            <% if session.disable_video_proxying then %>
                                <video controls preload="none" poster="<%= proxy_url(post.image_versions2.candidates[1].url) %>">
                                    <source crossorigin="anonymous" src="<%= post.video_versions[1].url %>">
                                </video>
                            <% else %>
                                <video controls preload="none" poster="<%= proxy_url(post.image_versions2.candidates[1].url) %>">
                                    <source src="<%= proxy_url(post.video_versions[1].url) %>">
                                </video>
                            <% end %>
                        <% elseif type(post.carousel_media_count) ~= "userdata"  and post.carousel_media_count > 0 then %>
                            <div class="carousel">
                                <% for _, item in ipairs(post.carousel_media) do %>
                                    <% if item.video_versions ~= json.null then %>
                                        <video controls preload="none" poster="<%= proxy_url(item.image_versions2.candidates[1].url) %>">
                                            <source src="<%= proxy_url(item.video_versions[1].url) %>">
                                        </video>
                                    <% else %>
                                        <img src="<%= proxy_url(item.image_versions2.candidates[1].url) %>" loading="lazy">
                                    <% end %>
                                <% end %>
                            </div>
                        <% elseif type(post.image_versions2) == "table" then %>
                            <img src="<%= proxy_url(post.image_versions2.candidates[1].url) %>" loading="lazy">
                        <% end %>
                    </div>
                    <div class="post-info">
                        <time class="post-time" datetime="<%= os.date('%Y-%m-%dT%H:%M:%S', post.timestamp) %>">Posted at: <%=  os.date('%Y-%m-%d %H:%M:%S', post.taken_at) %></time>
                        <div class="post-likes">
                            <p><%= post.like_count %> likes</p>
                        </div>
                        <div class="caption">
                            <% if type(post.caption) == "table" then %>
                                <p class="post-caption-text"><%= post.caption.text %></p>
                            <% end %>
                        </div>
            
                    </div>
                    <a href="<%= "/p/" .. post.code %>"> <%= post.comment_count %> Comments</a>
                </div>
        <% end %>
        </div>
        <a href="<%= "?after=" .. end_cursor %>" class="next-button">Next Page</a>
    <% end %>
</main>
