<% local proxy_url = require("lib.helpers").proxy_url %>
<% local json = require("cjson") %>

<main id="main">
    <% if user.has_errors then %>
        <div class="item-card">
            <p>Couldn't load user info due to error.</p>
            <details>
            <summary>More info</summary>
                <p><%= user.error_info.message %></p>
                <pre><%= user.error_info.blob %></pre>
            </details>
        </div>
    <% else %>
        <% render("views.widgets.user_info_card", { user = user }) %>
    <% end %>
    <div class="selector-group">
        <div class="selector">
            <% if params.path == "reels" then %>
                <a href="/<%= username %>"><%= strings.user.all %></a>
                <a class="selected" href="/<%= username %>/reels"><%= strings.user.reels %></a>
                <a href="/<%= username %>/highlights"><%= strings.user.highlights %></a>
            <% elseif params.path == "highlights" then %>
                <a href="/<%= username %>"><%= strings.user.all %></a>
                <a href="/<%= username %>"/reels"><%= strings.user.reels %></a>
                <a class="selected" href="/<%= username %>/highlights"><%= strings.user.highlights %></a>
            <% else %>
                <a class="selected" href="/<%= username %>"><%= strings.user.all %></a>
                <a href="/<%= username %>/reels"><%= strings.user.reels %></a>
                <a href="/<%= username %>/highlights"><%= strings.user.highlights %></a>
            <% end %>
        </div>
        <div class="selector">
            <% if params.after then %>
                <% if params.view == "tile" then %>
                    <a href="<%= "/" .. username  .. "?after=" .. params.after %>"><%= strings.user.list %></a>
                    <a class="selected" href="?view=tile&after=<%= params.after %>"><%= strings.user.tile %></a>
                <% else %>
                    <a class="selected" href="<%= "/" .. username  .. "?after=" .. params.after %>"><%= strings.user.list %></a>
                    <a href="?view=tile&after=<%= params.after %>"><%= strings.user.tile %></a>
                <% end %>
            <% else %>
                <% if params.view == "tile" then %>
                    <a href="<%= "/" .. username %>"><%= strings.user.list %></a>
                    <a class="selected" href="?view=tile"><%= strings.user.tile %></a>
                <% else %>
                    <a class="selected" href="<%= "/" .. username %>"><%= strings.user.list %></a>
                    <a href="?view=tile"><%= strings.user.tile %></a>
                <% end %>
            <% end %>
        </div>
    </div>
    <% if user.is_private then %>
        <div class="item-card">
            <h3><%= strings.user.user_is_private %></h3>
            <a href="<%= view_on_instagram_link %>"><%= strings.view_on_instagram %></a>
        </div>
    <% elseif posts and #posts < 1 then %>
        <div class="item-card">
            <h3><%= strings.user.has_no_posts %></h3>
        </div>
    <% elseif highlights then %>
        <% render("views.widgets.highlights_tray", { highlights = highlights}) %>
    <% else %>
        <% if params.view == "tile" then %>
            <div class="tile-container">
                <% for _, post in ipairs(posts) do %>
                    <% render("views.widgets.tile_post", { post = post} ) %>
                <% end %>
            </div>
            <% if end_cursor and end_cursor ~= "None" then %>
                <a href="<%= "?after=" .. end_cursor %>&view=tile" class="next-button"><%= strings.next_page %></a>
            <% end %>
        <% else %>
            <div class="user-posts">
                <% for _, post in ipairs(posts) do %>
                    <% render("views.widgets.post_card", { post = post, include_comments_link = true}) %>
                <% end %>
                <% if end_cursor and end_cursor ~= "None" then %>
                    <a href="<%= "?after=" .. end_cursor %>" class="next-button"><%= strings.next_page %></a>
                <% end %>
            </div>
        <% end %>
    <% end %>
</main>
