<% local proxy_url = require("lib.helpers").proxy_url %>
<% local json = require("cjson") %>

<main id="main">
    <% if user.info and user.info.has_errors then %>
        <% render("views.widgets.error_card", {
            title = "",
            description = "Couldn't load user info due to an error.",
            error = user.info
        }) %>
    <% else %>
        <% render("views.widgets.user_info_card", { user_info = user.info }) %>
    <% end %>

    <% if stories_enabled then %>
        <% render("views.widgets.highlights_tray", {
            highlights = highlights,
            stories_link = "/stories/" .. username,
            stories_image = user.info.profile_picture,
        }) %>
    <% end %>

    <div class="selector-group">
        <%
            local all_link, reels_link
            if selectors.selected_view == "timeline" then
                all_link = "/" .. username .. "?view=timeline"
                reels_link = "/" .. username .. "/reels"
            else
                all_link = "/" .. username
                reels_link = "/" .. username .. "/reels"
            end

            local feed_options = {
                { type = "all", label = strings.user.all, link = all_link },
                { type = "reels", label = strings.user.reels, link = reels_link }
            }
            if require("lib.helpers").session_enabled_for("tagged") then
                table.insert(feed_options, { type = "tagged", label = strings.user.tagged or "Tagged", link = "/" .. username .. "/tagged" })
            end
            render("views.widgets.selector", { list_options = feed_options, selected_option = selectors.selected_feed })
        %>

        <% if not is_grid_only then %>
            <% render("views.widgets.selector", { list_options = {
                { type = "grid", label = strings.user.grid, link = "/" .. username },
                { type = "timeline", label = strings.user.list, link = "/" .. username .. "?view=timeline" },
                { type = "tile", label = strings.user.tile, link = "/" .. username .. "?view=tile" }
            }, selected_option = selectors.selected_view }) %>
        <% end %>
    </div>

    <% if user.info.is_private then %>
        <div class="item-card">
            <h3><%= strings.user.user_is_private %></h3>
            <a href="<%= view_on_instagram_link %>"><%= strings.view_on_instagram %></a>
        </div>
    <% elseif user.timeline and user.timeline.items and #user.timeline.items < 1 then %>
        <div class="item-card">
            <h3><%= strings.user.has_no_posts %></h3>
        </div>
    <% elseif selectors.selected_feed == "tagged" and user.grid and #user.grid.items < 1 then %>
        <div class="item-card">
            <h3><%= strings.user.has_no_tagged_posts or "No posts tagging this user." %></h3>
        </div>
    <% elseif user.grid then %>
        <div class="grid">
            <% for _, item in ipairs(user.grid.items) do  %>
                <% render("views.widgets.grid_item", { item = item }) %>
            <% end %>
        </div>
        <% if user.grid.cursor then %>
            <a href="<%= "?after=" .. user.grid.cursor %>" class="next-button"><%= strings.next_page %></a>
        <% end %>
    <% else %>
        <% if params.view == "tile" then %>
            <div class="tile-container">
                <% for _, post in ipairs(user.timeline.items) do %>
                    <% render("views.widgets.tile_post", { post = post} ) %>
                <% end %>
            </div>
            <% if user.timeline.cursor then %>
                <a href="<%= "?after=" .. user.timeline.cursor .. "&view=tile" %>" class="next-button"><%= strings.next_page %></a>
            <% end %>
        <% else %>
            <div class="user-posts">
                <% for _, post in ipairs(user.timeline.items) do %>
                    <% render("views.widgets.post_card", { post = post, include_comments_link = true}) %>
                <% end %>
            </div>
            <% if user.timeline.cursor then %>
                <a href="<%= "?after=" .. user.timeline.cursor .. "&view=timeline" %>" class="next-button"><%= strings.next_page %></a>
            <% end %>
        <% end %>
    <% end %>
</main>
