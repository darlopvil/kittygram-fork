
<main id="main">
    <% if error.error_type == "not_found" then %>
        <% render("views.widgets.error_card", { title = "Not Found.",
            description = "The requested content was not found. Your link could be broken, or the item may have been deleted.",
            has_details = true,
            error = error
        }) %>
    <% elseif error.error_type == "ratelimited" then %>
        <% render("views.widgets.error_card", {
            title = "This instance has been ratelimited.",
            description = "Try again in a few minutes.",
            has_details = true,
            error = error
        }) %>
    <% elseif error.error_type == "route_not_defined" then %>
        <% render("views.widgets.error_card", {
            title = "Page not found.",
            description = "Your link may be broken.",
            has_details = true,
            error = error
        }) %>
    <% elseif error.error_type == "blocked" then %>
        <% render("views.widgets.error_card", {
            title = "Blocked by instagram.",
            description = "This server has been blocked from accessing some data by instagram. \nNon-private users or users with posts may still be accessible",
            has_details = true,
            error = error
        }) %>
    <% elseif error.error_type == "null_content" then %>
        <% render("views.widgets.error_card", {
            title = "Post unavailable.",
            description = "This post is unavailable on kittygram.",
            has_details = true,
            error = error,
            include_instagram_link = true,
        }) %>
    <% elseif error.error_type == "feature_not_supported" then %>
        <% render("views.widgets.error_card", {
            title = "This feature is unavailable on kittygram.",
            description = "",
            has_details = true,
            error = error,
            include_instagram_link = true,
        }) %>
    <% else %>
        <% render("views.widgets.error_card", {
            title = "Error!",
            description = "An unexpected error occurred.",
            has_details = true,
            error = error
        }) %>
    <% end %>
</main>
