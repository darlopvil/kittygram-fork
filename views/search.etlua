<main id="main">
    <h2 class="item-heading"><%= strings.explore.search %></h2>
    <div class="item-card search-form">
        <form method="GET">
            <input type="text" placeholder="<%= strings.explore.enter_search %>" name="q">
            <button><%= strings.explore.search %></button>
        </form>
    </div>
</main>
