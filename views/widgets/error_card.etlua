<div class="item-card">
    <h2><%= title %></h2>
    <p><%= description %>

    <% if include_instagram_link then %>
        <p><a href="<%= view_on_instagram_link %>">View on instagram</a></p>
    <% end %>

    <% if has_details then %>
        <details>
        <summary>More Details</summary>
            <p><%= error.error_info.message %></p>
            <% if show_error_details and error.error_info.blob then %>
            <pre>
                <%= error.error_info.blob %>
            </pre>
            <% end %>
        </details>
    <% end %>

</div>
