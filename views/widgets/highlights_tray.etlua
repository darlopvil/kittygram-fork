<% local proxy_url = require("lib.helpers").proxy_url %>

<div class="popular-row item-card">
    <% if stories_link then %>
        <div class="popular-row-item">
            <a href="<%= stories_link %>">
                <% if stories_image then %>
                    <img src="<%= proxy_url(stories_image) %>" loading="lazy">
                <% end %>
                <%= strings.user.stories or "Stories" %>
            </a>
        </div>
    <% end %>
    <% for _, item in ipairs(highlights or {}) do %>
        <div class="popular-row-item">
            <a href="/stories/highlights/<%= item.id %>">
                <% if item.image then %>
                    <img src="<%= proxy_url(item.image) %>" loading="lazy">
                <% end %>
                <%= item.title %>
            </a>
        </div>
    <% end %>
</div>
