<% local proxy_url = require("lib.helpers").proxy_url %>
<% local comma_value = require("lib.helpers").comma_value %>

<div class="item-card post">
    <div class="user-info">
        <img src="<%= proxy_url(post.user.profile_picture) %>" loading="lazy">
        <a class="username" href="<%= "/" .. post.user.username %>"> <%= post.user.username %> </a>
    </div>
    <div class="post-image">
        <% if post.video_url then %>
            <video controls preload="none" poster="<%= proxy_url(post.video_thumbnail) %>">
                <% if session.disable_video_proxying then %>
                    <source crossorigin="anonymous" src="<%= post.video_url %>">
                <% else %>
                    <source src="<%= proxy_url(post.video_url) %>">
                <% end %>
            </video>
        <% elseif post.images then %>
            <div class="carousel">
                <% for _, image in ipairs(post.images) do %>
                    <% if image.video_url then %>
                        <video controls preload="none" poster="<%= proxy_url(image.video_thumbnail) %>">
                            <% if session.disable_video_proxying then %>
                                <source crossorigin="anonymous" src="<%= image.video_url %>">
                            <% else %>
                                <source src="<%= proxy_url(image.video_url) %>">
                            <% end %>
                        </video>
                    <% else %>
                        <img src="<%= proxy_url(image.image_url) %>" alt="<%= image.alt_text %>" loading="lazy">
                    <% end %>
                <% end %>
            </div>
        <% elseif not post.images and post.image_url then %>
            <img src="<%= proxy_url(post.image_url) %>" alt="<%= post.alt_text %>" loading="lazy">
        <% else %>
            <p>Image couldn't be detected.</p>
        <% end %>
    </div>
    <div class="post-info">
        <time class="post-time" datetime="<%= os.date('%Y-%m-%dT%H:%M:%S', post.timestamp) %>"><%= strings.post.posted_at .. os.date('%Y-%m-%d %H:%M:%S', post.timestamp) %></time>
        <div class="post-likes">
            <p><%= comma_value(post.likes) .. strings.post.likes %></p>
        </div>
        <div class="post-body">
            <div class="caption">
                <% if post.caption then %>
                    <p class="post-caption-text"><%= post.caption %></p>
                <% end %>
            </div>

            <% if comments then %>
                <h2><%= strings.post.comments %></h2>
                <div class="comments">
                    <% if comments.has_errors then %>
                        <p><%= strings.post.error_loading_comments ..  (comments.error_info or {}).message or "Unknown error" %></p>
                    <% else %>
                        <% for _, comment in ipairs(comments) do %>
                            <% comment = comment.node %>
                            <article>
                                <header class="user-info">
                                    <img src="<%= proxy_url(comment.user.profile_pic_url) %>" loading="lazy">
                                    <a class="username" href="<%= "/" .. comment.user.username %>"> <%= comment.user.username %> </a>
                                </header>
                                <p class="comment-text"><%= comment.text %></p>
                                <% if type(comment.giphy_media_info) == "table" then %>
                                    <img src="<%= proxy_url(comment.giphy_media_info.first_party_cdn_proxied_images.fixed_height.url) %>" loading="lazy">
                                <% end %>
                            </article>
                        <% end %>
                        <hr>
                        <p><i><%= strings.post.fetching_comments_impossible %></i></p>
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
    <% if include_comments_link then %>
        <a href="<%= "/p/" .. post.shortcode %>"> <%= post.comment_count %> <%= string.lower(strings.post.comments) %></a>
    <% end %>
</div>
