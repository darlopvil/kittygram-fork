<% local proxy_url = require("lib.helpers").proxy_url %>
<% local comma_value = require("lib.helpers").comma_value(strings.thousand_separator) %>

<div class="item-card user-info-card">
    <div class="profile-picture">
        <% if user_info.hd_profile_picture then %>
            <a href="<%= user_info.hd_profile_picture %>">
                <img src="<%= proxy_url(user_info.profile_picture) %>" loading="lazy">
            </a>
        <% else %>
            <img src="<%= proxy_url(user_info.profile_picture) %>" loading="lazy">
        <% end %>
    </div>
    <div class="usernames" >
        <h3> <%= user_info.display_name %> </h3>
        <p> @<%= user_info.username %>
        <% if user_info.is_verified then %>
            <span title="<%= strings.user.verified %>" class="verification-symbol"><% render("views.widgets.icon", { id = "checkmark", size = 18 }) %></span>
        <% end %>
        </p>
    </div>
    <div class="user-bio">
        <p class="user-bio-text"><%= user_info.biography or "" %></p>
    </div>
    <div class="profile-stats">
        <ul>
            <li><b class="stat-number"><%= comma_value(user_info.followers) %></b> <p><%= strings.user.followers %></p></li>
            <li><b class="stat-number"><%= comma_value(user_info.following) %></b> <p><%= strings.user.following %></p></li>
            <li><b class="stat-number"><%= comma_value(user_info.media_count) %></b> <p><%= strings.user.posts %></p></li>
        </ul>
    </div>
</div>
