<% local proxy_url = require("lib.helpers").proxy_url %>
<% local comma_value = require("lib.helpers").comma_value(strings.thousand_separator) %>

<div class="item-card user-info-card">
    <div class="profile-picture">
        <% if user.hd_profile_pic_url_info then %>
            <a href="<%= user.hd_profile_pic_url_info.url %>">
                <img src="<%= proxy_url(user.profile_pic_url) %>" loading="lazy">
            </a>
        <% else %>
            <img src="<%= proxy_url(user.profile_pic_url) %>" loading="lazy">
        <% end %>
    </div>
    <div class="usernames" >
        <h3> <%= user.full_name %> </h3>
        <p> @<%= user.username %>
        <% if user.is_verified then %>
            <span title="<%= strings.user.verified %>" class="verification-symbol"><% render("views.widgets.icon", { id = "checkmark", size = 18 }) %></span>
        <% end %>
        </p>
    </div>
    <div class="user-bio">
        <p class="user-bio-text"><%= user.biography or "" %></p>
    </div>
    <div class="profile-stats">
        <ul>
            <li><b class="stat-number"><%= comma_value(user.follower_count) %></b> <p><%= strings.user.followers %></p></li>
            <li><b class="stat-number"><%= comma_value(user.following_count) %></b> <p><%= strings.user.following %></p></li>
            <li><b class="stat-number"><%= comma_value(user.media_count) %></b> <p><%= strings.user.posts %></p></li>
        </ul>
    </div>
</div>
